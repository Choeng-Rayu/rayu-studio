# Hosted Rayu Studio: copy to .env.local for local development.
# User AI keys and service tokens belong in Studio Settings / the Rayu database,
# not in this file. Configure provider OAuth applications in the existing admin.

# Rayu services (local development). Use your public HTTPS URLs in production.
RAYU_BACKEND_URL=http://localhost:4000/api
# Public, BUILD-time URL for the Remote/Web Bridge browser client.
# Keep it pointed at the same backend as RAYU_BACKEND_URL.
VITE_RAYU_BACKEND_URL=http://localhost:4000/api
RAYU_GATEWAY_URL=http://localhost:8080
RAYU_STUDIO_AUTH_BRIDGE_URL=http://localhost:3000/studio-login

# Server-only: use the SAME random value as rayu-backend (32+ characters).
# Never prefix with VITE_, commit a real value, or include it in Electron.
RAYU_STUDIO_SERVER_SECRET=

# Optional public BUILD-time logging setting: debug, info, warn, error.
VITE_LOG_LEVEL=info

# Optional local model services, only if you actually use them.
# These are server endpoints; hosted Studio cannot reach a user's laptop localhost.
# OLLAMA_API_BASE_URL=http://127.0.0.1:11434
# LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234
# DEFAULT_NUM_CTX=32768

# Coolify: set service URLs and RAYU_STUDIO_SERVER_SECRET at runtime.
# Set VITE_RAYU_BACKEND_URL (and optional VITE_LOG_LEVEL) at build time.
# Register Studio's /auth/callback in rayu-web STUDIO_ALLOWED_REDIRECT_URIS.
# No Google client secret, database URL, or provider encryption key belongs here.
